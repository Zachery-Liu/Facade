  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "esbuild": "0.28.2",
    "tsup": "^8.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1",
